    if (nombre) {
      btnLogin.innerHTML = `<span class="uppercase tracking-widest text-[10px] sm:text-xs font-bold text-slate-300">CERRAR SESIÓN</span>`;
      btnLogin.className = "px-4 py-2 bg-slate-900 border border-red-900/50 hover:border-red-500 rounded transition-colors flex items-center cursor-pointer shadow-sm";
      panelCronometro.classList.remove('hidden');
      iniciarCronometro(nombre);
    } else {
      btnLogin.innerHTML = 'INICIAR SESIÓN';
      btnLogin.className = "px-5 py-2 bg-slate-800 hover:bg-slate-700 border border-slate-700 text-slate-200 font-bold uppercase tracking-wider text-xs rounded transition-colors cursor-pointer";
      panelCronometro.classList.add('hidden');
      detenerCronometro();
    }
  }

  function actualizarDisplayTiempo() {
    const min = Math.floor(segundosActivos / 60);
    const sec = segundosActivos % 60;
    displayTiempo.innerText = `${min.toString().padStart(2, '0')}:${sec.toString().padStart(2, '0')}`;
    displayPuntos.innerText = puntosGanados;
  }

  function iniciarCronometro(nombre) {
    if (cronometroInterval) clearInterval(cronometroInterval);
    actualizarDisplayTiempo();

    cronometroInterval = setInterval(async () => {
      // Calculamos cuánto lleva hoy sumando lo de la base de datos + la sesión actual
      let puntosHoyDB = parseInt(sessionStorage.getItem('puntosHoyDB')) || 0;

      if (!document.hidden && (puntosHoyDB + puntosGanados) < 90) {
        segundosActivos++;
        sessionStorage.setItem('segundosActivos', segundosActivos);
        
        const minutosActuales = Math.floor(segundosActivos / 60);
        actualizarDisplayTiempo();

        if (minutosActuales > puntosGanados) {
          puntosGanados = minutosActuales;
          sessionStorage.setItem('puntosGanados', puntosGanados);
          displayPuntos.innerText = puntosGanados;

          try {
            const alumnoRef = doc(db, "ranking", nombre);
            const docSnap = await getDoc(alumnoRef);
            if (docSnap.exists()) {
              const perfil = docSnap.data();
              const hoy = new Date().toDateString();
              
              if (perfil.ultimaFecha !== hoy) {
                perfil.ultimaFecha = hoy;
                perfil.puntosHoy = 0;
              }

              if ((perfil.puntosHoy || 0) < 90) {
                perfil.puntos += 1;
                perfil.puntosHoy = (perfil.puntosHoy || 0) + 1;
                await setDoc(alumnoRef, perfil);
                
                // Actualizamos la variable local en base a lo guardado
                sessionStorage.setItem('puntosHoyDB', perfil.puntosHoy - puntosGanados);
              }
            }
          } catch (e) { console.error("Error al guardar el punto:", e); }
        }
      }
      
      // Detener visualmente si llega al tope diario
      let puntosActualizados = parseInt(sessionStorage.getItem('puntosHoyDB')) || 0;
      if ((puntosActualizados + puntosGanados) >= 90) {
          displayTiempo.innerText = "MÁX. DIARIO";
          displayTiempo.classList.add("text-yellow-500");
      }
    }, 1000);
  }

  function detenerCronometro() {
    if (cronometroInterval) clearInterval(cronometroInterval);
    segundosActivos = 0;
    puntosGanados = 0;
    displayTiempo.classList.remove("text-yellow-500");
    sessionStorage.removeItem('segundosActivos');
    sessionStorage.removeItem('puntosGanados');
    sessionStorage.removeItem('puntosHoyDB');
  }

  actualizarUI();

  btnLogin.addEventListener('click', () => {
    const nombreActual = sessionStorage.getItem('alumnoBanda');
    if (nombreActual) {
      if(confirm(`¿Terminaste tu ensayo, ${nombreActual}?\n\nLograste sumar ${puntosGanados} puntos en esta sesión.`)) {
        sessionStorage.removeItem('alumnoBanda');
        actualizarUI();
      }
    } else {
      loginBanner.classList.toggle('hidden');
    }
  });

  btnCerrarBanner.addEventListener('click', () => {
    loginBanner.classList.add('hidden');
    selectNombre.value = ''; 
  });

  btnGuardarLogin.addEventListener('click', async () => {
    const nombre = selectNombre.value;
    
    if (nombre) {
      const textoOriginal = btnGuardarLogin.innerHTML;
      btnGuardarLogin.innerHTML = "CARGANDO...";
      btnGuardarLogin.disabled = true;

      try {
        const alumnoRef = doc(db, "ranking", nombre);
        const docSnap = await getDoc(alumnoRef);
        
        const hoy = new Date().toDateString();
        let perfil = docSnap.exists() ? docSnap.data() : { puntos: 0, ultimaFecha: hoy, iniciosHoy: 0, puntosHoy: 0, nombre: nombre };

        // Si es un nuevo día, reiniciamos su contador diario
        if (perfil.ultimaFecha !== hoy) {
          perfil.ultimaFecha = hoy;
          perfil.iniciosHoy = 0;
          perfil.puntosHoy = 0;
        }

        perfil.iniciosHoy++; // Guardamos un registro estadístico de cuántas veces entra al día
        await setDoc(alumnoRef, perfil);

        sessionStorage.setItem('alumnoBanda', nombre); 
        sessionStorage.setItem('puntosHoyDB', perfil.puntosHoy || 0); // Cargamos su progreso del día
        
        detenerCronometro(); 
        loginBanner.classList.add('hidden'); 
        selectNombre.value = '';
        actualizarUI(); 
        
        // Mensaje dinámico dependiendo de si ya logró los 90 puntos antes de entrar
        if ((perfil.puntosHoy || 0) >= 90) {
          alert(`¡Hola, ${nombre}!\n\nYa acumulaste tus 90 puntos de hoy. Puedes seguir usando el material para ensayar, pero el cronómetro ya no sumará más puntos en el ranking hasta mañana.`);
        } else {
          alert(`¡Sesión iniciada, ${nombre}!\n\nEl cronómetro comenzará a correr ahora. Ganarás 1 punto por cada minuto (hasta un máximo de 90 al día).\nRecuerda que si abres otra pestaña o minimizas el navegador, el tiempo se pausará.`);
        }

      } catch (error) {
        console.error("Error al iniciar sesión:", error);
        alert("Error de conexión con la base de datos. Inténtalo de nuevo.");
      } finally {
        btnGuardarLogin.innerHTML = textoOriginal;
        btnGuardarLogin.disabled = false;
      }
      
    } else {
      selectNombre.classList.add('ring-2', 'ring-red-500');
      setTimeout(() => selectNombre.classList.remove('ring-2', 'ring-red-500'), 1500);
    }
  });

  btnCerrarBanner.addEventListener('click', () => {
    loginBanner.classList.add('hidden');
    selectNombre.value = ''; 
  });

  btnGuardarLogin.addEventListener('click', async () => {
    const nombre = selectNombre.value;
    
    if (nombre) {
      const textoOriginal = btnGuardarLogin.innerHTML;
      btnGuardarLogin.innerHTML = "CARGANDO...";
      btnGuardarLogin.disabled = true;

      try {
        const alumnoRef = doc(db, "ranking", nombre);
        const docSnap = await getDoc(alumnoRef);
        
        const hoy = new Date().toDateString();
        let perfil = docSnap.exists() ? docSnap.data() : { puntos: 0, ultimaFecha: hoy, iniciosHoy: 0, puntosHoy: 0, nombre: nombre };

        // Si es un nuevo día, reiniciamos su contador diario
        if (perfil.ultimaFecha !== hoy) {
          perfil.ultimaFecha = hoy;
          perfil.iniciosHoy = 0;
          perfil.puntosHoy = 0;
        }

        // ELIMINAMOS EL BLOQUEO AQUÍ.
        // Ahora solo sumamos +1 a las veces que ha entrado, pero no lo bloqueamos.
        perfil.iniciosHoy++; 
        await setDoc(alumnoRef, perfil);

        sessionStorage.setItem('alumnoBanda', nombre); 
        sessionStorage.setItem('puntosHoyDB', perfil.puntosHoy || 0); // Cargamos su progreso del día
        
        detenerCronometro(); 
        loginBanner.classList.add('hidden'); 
        selectNombre.value = '';
        actualizarUI(); 

      } catch (error) {
        console.error("Error al iniciar sesión:", error);
        alert("Error de conexión con la base de datos. Inténtalo de nuevo.");
      } finally {
        btnGuardarLogin.innerHTML = textoOriginal;
        btnGuardarLogin.disabled = false;
      }
      
    } else {
      selectNombre.classList.add('ring-2', 'ring-red-500');
      setTimeout(() => selectNombre.classList.remove('ring-2', 'ring-red-500'), 1500);
    }
  });

  // === ESCUCHADOR EN TIEMPO REAL PARA EL RANKING ===
  const contenedorRanking = document.getElementById('tabla-ranking-contenedor');
  
  if (contenedorRanking) {
    const q = query(collection(db, "ranking"), orderBy("puntos", "desc"));
    
    onSnapshot(q, (querySnapshot) => {
      if (querySnapshot.empty) {
        contenedorRanking.innerHTML = `
          <div class="bg-slate-900/50 border border-slate-800 rounded-lg p-8 text-center text-slate-500 text-sm">
            Aún no hay registros de ensayo. ¡Sé el primero en sumar puntos!
          </div>`;
        return;
      }

      let html = `<div class="bg-slate-900 border border-slate-800 rounded-md overflow-hidden shadow-2xl">`;
      let index = 0;
      
      querySnapshot.forEach((doc) => {
        const alumno = doc.data();
        const esTop = index < 3;
        const fondoFila = esTop ? "bg-slate-800/50 border-yellow-500/20" : "border-b border-slate-800/60";
        const brilloTexto = esTop ? "text-transparent bg-clip-text bg-gradient-to-r from-yellow-200 to-yellow-600 drop-shadow-[0_0_8px_rgba(234,179,8,0.5)] font-bold" : "text-slate-200";

        let posicion = "";
        if (index === 0) posicion = "🥇";
        else if (index === 1) posicion = "🥈";
        else if (index === 2) posicion = "🥉";
        else posicion = `<span class="text-slate-600 font-mono text-xs w-5 inline-block">${index + 1}.</span>`;

        html += `
          <div class="flex justify-between items-center p-4 ${fondoFila} transition-all duration-300">
            <div class="flex items-center gap-3">
              <div class="w-6 text-center">${posicion}</div>
              <span class="text-sm ${brilloTexto}">${alumno.nombre}</span>
            </div>
            <span class="text-sm font-black text-yellow-500 font-mono drop-shadow-[0_0_5px_rgba(234,179,8,0.3)]">${alumno.puntos} PTS</span>
          </div>
        `;
        index++;
      });

      html += `</div>`;
      contenedorRanking.innerHTML = html;
    });
  }

  // === ALTERNAR ENTRE VIDEO Y MIDI ===
  window.cambiarModoPifano = function(numMarcha, modo) {
    const contVideo = document.getElementById(`youtube-pifano-${numMarcha}`);
    const contMidi = document.getElementById(`midi-pifano-${numMarcha}`);
    const btnVideo = document.getElementById(`btn-video-pifano-${numMarcha}`);
    const btnMidi = document.getElementById(`btn-midi-pifano-${numMarcha}`);

    if (!contVideo || !contMidi) return;

    if (modo === 'video') {
      contVideo.classList.remove('hidden');
      contMidi.classList.add('hidden');
      btnVideo.className = "px-6 py-2 text-xs uppercase font-bold bg-slate-800 text-yellow-500 rounded transition-all shadow-sm";
      btnMidi.className = "px-6 py-2 text-xs uppercase font-bold text-slate-400 hover:text-slate-200 transition-all rounded";
    } else {
      contMidi.classList.remove('hidden');
      contVideo.classList.add('hidden');
      btnMidi.className = "px-6 py-2 text-xs uppercase font-bold bg-slate-800 text-yellow-500 rounded transition-all shadow-sm";
      btnVideo.className = "px-6 py-2 text-xs uppercase font-bold text-slate-400 hover:text-slate-200 transition-all rounded";
    }
  };

  window.cambiarModoCorneta = function(numMarcha, modo) {
    const contVideo = document.getElementById(`youtube-corneta-${numMarcha}`);
    const contMidi = document.getElementById(`midi-corneta-${numMarcha}`);
    const btnVideo = document.getElementById(`btn-video-corneta-${numMarcha}`);
    const btnMidi = document.getElementById(`btn-midi-corneta-${numMarcha}`);
    
    if (!contVideo || !contMidi) return;

    if (modo === 'video') {
      contVideo.classList.remove('hidden');
      contMidi.classList.add('hidden');
      btnVideo.className = "px-6 py-2 text-xs uppercase font-bold bg-slate-800 text-yellow-500 rounded transition-all shadow-sm";
      btnMidi.className = "px-6 py-2 text-xs uppercase font-bold text-slate-400 hover:text-slate-200 transition-all rounded";
    } else {
      contMidi.classList.remove('hidden');
      contVideo.classList.add('hidden');
      btnMidi.className = "px-6 py-2 text-xs uppercase font-bold bg-slate-800 text-yellow-500 rounded transition-all shadow-sm";
      btnVideo.className = "px-6 py-2 text-xs uppercase font-bold text-slate-400 hover:text-slate-200 transition-all rounded";
    }
  };

  // === LÓGICA DEL PANEL ADMIN PROFESOR ===
  const PASS_ADMIN = "admin2123.huique"; // <-- CAMBIA TU CONTRASEÑA AQUÍ

  const modalAdmin = document.getElementById('modal-admin');
  const btnAbrirAdmin = document.getElementById('btn-abrir-admin');
  const btnCerrarAdmin = document.getElementById('btn-cerrar-admin');
  const adminLoginScreen = document.getElementById('admin-login-screen');
  const adminPanelScreen = document.getElementById('admin-panel-screen');
  const inputPassAdmin = document.getElementById('input-pass-admin');
  const btnEntrarAdmin = document.getElementById('btn-entrar-admin');
  const selectAdminNombre = document.getElementById('select-admin-nombre');
  const inputAdminPuntos = document.getElementById('input-admin-puntos');
  const btnAdminSumar = document.getElementById('btn-admin-sumar');
  const btnAdminRestar = document.getElementById('btn-admin-restar');

  btnAbrirAdmin.addEventListener('click', () => {
    modalAdmin.classList.remove('hidden');
    adminLoginScreen.classList.remove('hidden');
    adminPanelScreen.classList.add('hidden');
    inputPassAdmin.value = '';
  });

  btnCerrarAdmin.addEventListener('click', () => {
    modalAdmin.classList.add('hidden');
  });

  btnEntrarAdmin.addEventListener('click', () => {
    if (inputPassAdmin.value === PASS_ADMIN) {
      adminLoginScreen.classList.add('hidden');
      adminPanelScreen.classList.remove('hidden');
      selectAdminNombre.innerHTML = document.getElementById('select-nombre').innerHTML;
    } else {
      inputPassAdmin.classList.add('ring-2', 'ring-red-500');
      setTimeout(() => inputPassAdmin.classList.remove('ring-2', 'ring-red-500'), 500);
    }
  });

  async function modificarPuntosAdmin(operacion) {
    const nombre = selectAdminNombre.value;
    const puntosAModificar = parseInt(inputAdminPuntos.value);

    if (!nombre) {
      alert("Selecciona un alumno de la lista.");
      return;
    }
    if (isNaN(puntosAModificar) || puntosAModificar <= 0) {
      alert("Ingresa una cantidad válida de puntos.");
      return;
    }

    const alumnoRef = doc(db, "ranking", nombre);
    try {
      const docSnap = await getDoc(alumnoRef);
      let perfil = { puntos: 0, ultimaFecha: "", iniciosHoy: 0, nombre: nombre, ultimoCheckIn: 0 };

      if (docSnap.exists()) {
        perfil = docSnap.data();
      }

      if (operacion === 'sumar') {
        perfil.puntos += puntosAModificar;
      } else if (operacion === 'restar') {
        perfil.puntos -= puntosAModificar;
        if (perfil.puntos < 0) perfil.puntos = 0; 
      }

      await setDoc(alumnoRef, perfil);
      alert(`¡Éxito! ${nombre} ahora tiene ${perfil.puntos} puntos en total.`);
    } catch (error) {
      console.error("Error al modificar puntos:", error);
      alert("Hubo un error de conexión con la base de datos.");
    }
  }

  btnAdminSumar.addEventListener('click', () => modificarPuntosAdmin('sumar'));
  btnAdminRestar.addEventListener('click', () => modificarPuntosAdmin('restar'));
  
</script>
  </body>
</html>